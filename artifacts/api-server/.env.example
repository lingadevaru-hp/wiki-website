PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/wiki

# Use the Zoho SMTP host for your mailbox region; India uses smtp.zoho.in.
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=newsletter@lingadevaru.in
ZOHO_SMTP_PASSWORD=replace-with-a-Zoho-app-password

# Comma-separated owner inboxes for "new subscriber" alerts.
NEWSLETTER_OWNER_EMAILS=dev@lingadevaru.in,newsletter@lingadevaru.in

# Set the same private random token on the Cloudflare Worker in production.
NEWSLETTER_PROXY_TOKEN=replace-with-a-long-random-token
