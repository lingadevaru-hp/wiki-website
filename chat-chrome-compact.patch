+    if ((e.target as HTMLElement).closest("button")) return;
+    if (window.matchMedia("(min-width: 901px)").matches) return;
     e.preventDefault();
     const panel = panelRef.current;
     if (!panel) return;
@@ -370,6 +374,23 @@ export default function ChatPanel() {
         aria-hidden="true"
